<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tembak Pesawat Luar Angkasa</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;700&display=swap">
<style>
:root{--bg:#070914;--ink:#e8ecff;--dim:#8a93c2;--hot:#ff7a3d;--cool:#4fe3ff;--panel:rgba(10,14,34,.82);color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);font-family:"Chakra Petch",system-ui,sans-serif;overflow:hidden;touch-action:none;user-select:none}
#stage{position:fixed;inset:0}
canvas{display:block;width:100%;height:100%}
#hud{position:fixed;left:0;right:0;top:env(safe-area-inset-top,0px);display:flex;justify-content:space-between;padding:14px 18px;font-size:clamp(16px,3.4vw,24px);font-weight:700;pointer-events:none}
#hud span small{display:block;font-size:.55em;font-weight:500;color:var(--dim)}
#lives{color:var(--hot);letter-spacing:.15em}
#ov{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(5,7,18,.55);padding:20px}
#card{background:var(--panel);border:2px solid var(--cool);padding:28px 32px;max-width:420px;text-align:center;border-radius:4px 22px 4px 22px}
#card h1{margin:0 0 8px;font-size:clamp(26px,6vw,38px);line-height:1.1;color:var(--cool)}
#card p{margin:6px 0;color:var(--dim);line-height:1.5}
#card b{color:var(--ink)}
button{margin-top:16px;font:inherit;font-weight:700;font-size:18px;padding:12px 30px;background:var(--hot);color:#1a0c04;border:0;border-radius:4px 14px 4px 14px;cursor:pointer}
button:focus-visible{outline:3px solid var(--cool);outline-offset:3px}
.hide{display:none!important}
.ghost{background:transparent;color:var(--dim);border:1px solid var(--dim);font-size:15px;margin-left:8px}
#bb{position:fixed;left:50%;top:calc(env(safe-area-inset-top,0px) + 62px);transform:translateX(-50%);width:min(420px,80vw);text-align:center;font-weight:700;color:var(--hot);pointer-events:none}
#bb span{display:block;height:10px;margin-top:4px;background:rgba(255,255,255,.12);border:1px solid var(--hot)}
#bb i{display:block;height:100%;width:100%;background:var(--hot)}
#warn{position:fixed;left:0;right:0;top:36%;text-align:center;font-size:clamp(20px,5vw,34px);font-weight:700;color:var(--hot);text-shadow:0 0 14px #000;pointer-events:none}
</style>
</head>
<body>
<div id="stage"></div>
<div id="hud"><span id="sc">0<small>Skor</small></span><span id="lives"></span><span id="bs">0<small>Terbaik</small></span></div>
<div id="bb" class="hide"><b>Raja Vakrath</b><span><i id="bf"></i></span></div>
<div id="warn" class="hide"></div>
<div id="ov"><div id="card">
<h1 id="ttl"></h1>
<p id="msg"></p>
<p id="sub"></p>
<button id="go">Lanjut</button><button id="sk" class="ghost">Lewati cerita</button>
</div></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
const T=THREE, BX=11, BY=6;
const stage=document.getElementById('stage');
const renderer=new T.WebGLRenderer({antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio||1,2));
renderer.outputEncoding=T.sRGBEncoding;renderer.toneMapping=T.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;
stage.appendChild(renderer.domElement);
const scene=new T.Scene();
scene.background=new T.Color(0x070914);
scene.fog=new T.Fog(0x070914,60,170);
const cam=new T.PerspectiveCamera(60,1,.1,300);
cam.position.set(0,1.5,14);
scene.add(new T.HemisphereLight(0x8fa6ff,0x1a1230,.5));
const sun=new T.DirectionalLight(0xfff0dd,2.2);sun.position.set(-6,10,6);scene.add(sun);
const rim=new T.DirectionalLight(0x4fe3ff,1.2);rim.position.set(6,-2,-10);scene.add(rim);
// Peta lingkungan: pantulan matahari dan nebula di badan logam
(function(){const c=document.createElement('canvas');c.width=512;c.height=256;const x=c.getContext('2d');
 const g=x.createLinearGradient(0,0,0,256);g.addColorStop(0,'#1c2a55');g.addColorStop(.5,'#0a0f26');g.addColorStop(1,'#05060f');x.fillStyle=g;x.fillRect(0,0,512,256);
 const sg=x.createRadialGradient(130,60,2,130,60,70);sg.addColorStop(0,'#fff6e0');sg.addColorStop(.15,'rgba(255,220,170,.8)');sg.addColorStop(1,'rgba(255,200,150,0)');x.fillStyle=sg;x.fillRect(0,0,512,256);
 const ng=x.createRadialGradient(380,150,5,380,150,110);ng.addColorStop(0,'rgba(120,70,220,.55)');ng.addColorStop(1,'rgba(120,70,220,0)');x.fillStyle=ng;x.fillRect(0,0,512,256);
 for(let i=0;i<150;i++){x.fillStyle='rgba(255,255,255,'+Math.random()+')';x.fillRect(Math.random()*512,Math.random()*256,1.5,1.5);}
 const tx=new T.CanvasTexture(c);tx.mapping=T.EquirectangularReflectionMapping;tx.encoding=T.sRGBEncoding;
 const pm=new T.PMREMGenerator(renderer);scene.environment=pm.fromEquirectangular(tx).texture;pm.dispose();})();
// Tekstur pelat logam buatan (garis panel, paku, goresan)
function hullTex(base,line,acc,rx,ry){
  const c=document.createElement('canvas');c.width=c.height=512;const x=c.getContext('2d');
  x.fillStyle=base;x.fillRect(0,0,512,512);
  for(let i=0;i<14;i++){x.fillStyle='rgba(0,0,0,'+(.06+Math.random()*.1)+')';x.fillRect(Math.random()*512,Math.random()*512,40+Math.random()*120,30+Math.random()*90);}
  for(let i=0;i<3000;i++){x.fillStyle='rgba(255,255,255,'+Math.random()*.06+')';x.fillRect(Math.random()*512,Math.random()*512,2,1);}
  x.strokeStyle=line;x.lineWidth=2;
  for(let i=0;i<9;i++){const p=i*64+(Math.random()*12|0);x.beginPath();x.moveTo(p,0);x.lineTo(p,512);x.stroke();x.beginPath();x.moveTo(0,p);x.lineTo(512,p);x.stroke();}
  x.fillStyle=line;for(let i=0;i<8;i++)for(let j=0;j<8;j++){x.fillRect(i*64+8,j*64+8,3,3);}
  x.fillStyle=acc;x.fillRect(70,190,150,10);x.fillRect(300,330,100,6);
  const t=new T.CanvasTexture(c);t.wrapS=t.wrapT=T.RepeatWrapping;t.encoding=T.sRGBEncoding;t.anisotropy=4;t.repeat.set(rx,ry);return t;}
function pbr(tex,m,r,col){return new T.MeshStandardMaterial({map:tex,bumpMap:tex,bumpScale:2,color:col===undefined?0xffffff:col,metalness:m,roughness:r});}
const glowTex=(function(){const c=document.createElement('canvas');c.width=c.height=64;const x=c.getContext('2d');const g=x.createRadialGradient(32,32,0,32,32,32);g.addColorStop(0,'rgba(255,255,255,1)');g.addColorStop(.25,'rgba(255,255,255,.5)');g.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=g;x.fillRect(0,0,64,64);return new T.CanvasTexture(c);})();
function glow(col,size){const s=new T.Sprite(new T.SpriteMaterial({map:glowTex,color:col,blending:T.AdditiveBlending,depthWrite:false,transparent:true}));s.scale.set(size,size,1);return s;}

function resize(){const w=innerWidth,h=innerHeight;renderer.setSize(w,h);cam.aspect=w/h;cam.fov=w/h<.8?75:60;cam.updateProjectionMatrix();}
addEventListener('resize',resize);resize();

// Bintang
const N=900,sp=new Float32Array(N*3);
for(let i=0;i<N;i++){sp[i*3]=(Math.random()-.5)*160;sp[i*3+1]=(Math.random()-.5)*100;sp[i*3+2]=-200+Math.random()*220;}
const sg=new T.BufferGeometry();sg.setAttribute('position',new T.BufferAttribute(sp,3));
scene.add(new T.Points(sg,new T.PointsMaterial({color:0xbfd0ff,size:.5,sizeAttenuation:true})));

// Pesawat pemain
const ship=new T.Group();
function wingGeo(p){const s=new T.Shape();s.moveTo(p[0][0],p[0][1]);for(let i=1;i<p.length;i++)s.lineTo(p[i][0],p[i][1]);return new T.ExtrudeGeometry(s,{depth:.1,bevelEnabled:true,bevelThickness:.05,bevelSize:.05,bevelSegments:2});}
const V=a=>a.map(p=>new T.Vector2(p[0],p[1]));
const hullM=pbr(hullTex('#7d889f','rgba(20,26,45,.7)','#4fe3ff',3,2),.9,.32);
const wingM=pbr(hullTex('#7d889f','rgba(20,26,45,.7)','#4fe3ff',.5,.5),.9,.32);wingM.side=T.DoubleSide;
const darkM=pbr(null,.9,.5,0x1a1f2e);darkM.side=T.DoubleSide;
const accM=new T.MeshStandardMaterial({color:0x4fe3ff,emissive:0x1a9fc0,metalness:.3,roughness:.4});
const glassM=new T.MeshPhysicalMaterial({color:0x0b1626,metalness:1,roughness:.04,clearcoat:1,envMapIntensity:2});
const flames=[],navs=[];
const fus=new T.Mesh(new T.LatheGeometry(V([[0,-2.5],[.4,-2.5],[.52,-2.1],[.64,-1.3],[.68,-.2],[.6,.9],[.42,1.8],[.22,2.4],[.07,2.75],[0,2.85]]),28).rotateX(-Math.PI/2),hullM);fus.scale.y=.75;ship.add(fus);
const wGeo=wingGeo([[.5,.7],[3.3,-1.4],[3.3,-1.9],[1.8,-1.75],[.5,-1.6]]).rotateX(-Math.PI/2);
const cGeo=wingGeo([[.4,.3],[1.7,-.5],[1.7,-.9],[.4,-.9]]).rotateX(-Math.PI/2);
const nozG=new T.LatheGeometry(V([[.22,-.7],[.3,-.3],[.28,.2],[.4,.6],[.34,.6],[.24,.2]]),14).rotateX(Math.PI/2);
const cyl=(r1,r2,l,s)=>new T.CylinderGeometry(r1,r2,l,s).rotateX(Math.PI/2);
[1,-1].forEach(s=>{
  const w=new T.Mesh(wGeo,wingM);w.position.y=-.1;w.scale.x=s;ship.add(w);
  const c=new T.Mesh(cGeo,wingM);c.position.set(0,-.05,-1.0);c.scale.x=s;ship.add(c);
  const fin=new T.Mesh(new T.BoxGeometry(.07,1.0,1.4),hullM);fin.position.set(.85*s,.55,1.3);fin.rotation.z=-.3*s;ship.add(fin);
  const pod=new T.Mesh(cyl(.09,.09,2.2,10),accM);pod.position.set(3.3*s,0,-.6);ship.add(pod);
  const mis=new T.Mesh(cyl(.09,.09,1.6,10),hullM);mis.position.set(1.8*s,-.22,-.2);ship.add(mis);
  const ink=new T.Mesh(new T.CylinderGeometry(.3,.24,1.4,14,1,true).rotateX(-Math.PI/2),darkM);ink.position.set(.72*s,-.05,.1);ship.add(ink);
  const nc=s>0?0x44ff77:0xff3355;
  const nav=new T.Mesh(new T.SphereGeometry(.09,8,8),new T.MeshBasicMaterial({color:nc}));nav.position.set(3.3*s,.08,-.4);nav.add(glow(nc,1.2));ship.add(nav);navs.push(nav);
  const nz=new T.Mesh(nozG,darkM);nz.position.set(.55*s,-.05,1.5);ship.add(nz);
  const core=new T.Mesh(new T.CircleGeometry(.3,16),new T.MeshBasicMaterial({color:0xffc890}));core.position.set(.55*s,-.05,2.0);ship.add(core);
  const fl=new T.Mesh(new T.ConeGeometry(.26,2.2,12,1,true),new T.MeshBasicMaterial({color:0x66ccff,transparent:true,opacity:.75,blending:T.AdditiveBlending,depthWrite:false}));
  fl.rotation.x=Math.PI/2;fl.position.set(.55*s,-.05,3.1);ship.add(fl);flames.push(fl);
  const gl=glow(0x66ccff,2.4);gl.position.set(.55*s,-.05,2.2);ship.add(gl);
});
const cock=new T.Mesh(new T.SphereGeometry(.42,20,14),glassM);cock.scale.set(.85,.65,2.1);cock.position.set(0,.38,-.5);ship.add(cock);
const spine=new T.Mesh(new T.BoxGeometry(.22,.14,2.4),darkM);spine.position.set(0,.55,1.0);ship.add(spine);
ship.scale.setScalar(.65);
scene.add(ship);

// Bahan
const foeM=pbr(hullTex('#4a2a34','rgba(10,5,10,.8)','#ff3b3b',.5,.5),.85,.4);foeM.side=T.DoubleSide;
const foeBody=pbr(hullTex('#4a2a34','rgba(10,5,10,.8)','#ff3b3b',3,2),.85,.4);
const heavyM=pbr(hullTex('#3a2a58','rgba(8,5,18,.8)','#c06bff',.5,.5),.85,.4);heavyM.side=T.DoubleSide;
const heavyBody=pbr(hullTex('#3a2a58','rgba(8,5,18,.8)','#c06bff',3,2),.85,.4);
const foeDarkM=pbr(null,.9,.5,0x14101c);
const redM=new T.MeshBasicMaterial({color:0xff3b3b});
const violM=new T.MeshBasicMaterial({color:0xd58bff});
const bulM=new T.MeshBasicMaterial({color:0xfff2a0}),bulM5=new T.MeshBasicMaterial({color:0x7ff0ff}),ebM=new T.MeshBasicMaterial({color:0xff4d6d});
const pupM=new T.MeshStandardMaterial({color:0xffd24a,emissive:0xb87400,metalness:.6,roughness:.3});
const goldM=new T.MeshStandardMaterial({color:0xffc93a,emissive:0x8a5a00,metalness:.9,roughness:.25});
const WN=['Tembakan ganda','Tembakan tiga jalur','Tembakan menyebar','Menyebar lima arah','Plasma, damage 2x'];
const bulG=new T.BoxGeometry(.14,.14,1.6);
const spG=new T.SphereGeometry(.18,6,6);
const sparkMats={o:new T.MeshBasicMaterial({color:0xff9a4d,transparent:true}),c:new T.MeshBasicMaterial({color:0x4fe3ff,transparent:true})};

let bullets=[],enemies=[],sparks=[];
let pups=[],ebul=[],boss=null,bossFlag=0,wl=1;
const eWing=wingGeo([[.4,.9],[2.6,-1.3],[2.6,-1.9],[1.4,-1.5],[.4,-1.3]]).rotateX(Math.PI/2);
const eBody=new T.LatheGeometry(V([[0,-1.8],[.35,-1.8],[.5,-1.2],[.55,-.3],[.45,.8],[.25,1.7],[.08,2.3],[0,2.5]]),20).rotateX(Math.PI/2);
const eCannon=cyl(.09,.12,2.0,8),eProng=new T.ConeGeometry(.1,1.8,8).rotateX(Math.PI/2),eStrip=new T.BoxGeometry(.07,.07,3.1);
function makeEnemy(heavy){
  const g=new T.Group(),k=heavy?1.5:1,wm=heavy?heavyM:foeM,bm=heavy?heavyBody:foeBody,gl=heavy?violM:redM,gc=heavy?0xd58bff:0xff3b3b;
  const f=new T.Mesh(eBody,bm);f.scale.set(k,.7*k,k);g.add(f);
  [1,-1].forEach(s=>{
    const w=new T.Mesh(eWing,wm);w.scale.set(s*k,1,k);w.position.y=-.05;g.add(w);
    const st=new T.Mesh(eStrip,gl);st.scale.z=k;st.position.set(1.5*k*s,.06,-.2*k);st.rotation.y=s*2.356;g.add(st);
    const pr=new T.Mesh(eProng,foeDarkM);pr.position.set(.55*k*s,-.1,1.7*k);pr.scale.setScalar(k);g.add(pr);
    const cn=new T.Mesh(eCannon,foeDarkM);cn.position.set(.9*s*k,-.1,.9*k);cn.scale.setScalar(k);g.add(cn);
    if(heavy){const tr=new T.Mesh(cyl(.07,.07,1.3,8),foeDarkM);tr.position.set(.2*s,.62,.4);g.add(tr);}
  });
  if(heavy){const dm=new T.Mesh(new T.SphereGeometry(.4,14,10),foeDarkM);dm.position.set(0,.45,-.4);g.add(dm);}
  const eye=new T.Mesh(new T.SphereGeometry(.3*k,12,8),gl);eye.scale.set(1.2,.4,1.6);eye.position.set(0,.32*k,.7*k);eye.add(glow(gc,2.6*k));g.add(eye);
  const eng=glow(0xff9a4d,2.2*k);eng.position.z=-2*k;g.add(eng);
  g.userData=heavy?{hp:3,pts:250,r:3.0,type:'h'}:{hp:1,pts:100,r:1.9,type:'d'};
  return g;
}
function burst(p,k,n){
  for(let i=0;i<n;i++){
    const m=new T.Mesh(spG,sparkMats[k].clone());m.position.copy(p);
    m.userData={v:new T.Vector3(Math.random()-.5,Math.random()-.5,Math.random()-.5).normalize().multiplyScalar(6+Math.random()*10),life:.7};
    scene.add(m);sparks.push(m);
  }
}

// Status
let state='menu',score=0,lives=3,t=0,fireT=0,spawnT=0,inv=0,shake=0;
let best=0;try{best=+localStorage.getItem('tpl-best')||0}catch(e){}
const $=id=>document.getElementById(id);
function hud(){$('sc').firstChild.nodeValue=score;$('bs').firstChild.nodeValue=Math.max(best,score);$('lives').textContent='♥'.repeat(Math.max(lives,0))+'  ⚡'+wl;}

// Input
const target=new T.Vector2(0,0);const keys={};
function pointer(x,y){target.set((x/innerWidth-.5)*2*BX,-(y/innerHeight-.5)*2*BY*1.3);}
addEventListener('pointermove',e=>pointer(e.clientX,e.clientY));
addEventListener('pointerdown',e=>pointer(e.clientX,e.clientY));
addEventListener('keydown',e=>{keys[e.key.toLowerCase()]=1;});
addEventListener('keyup',e=>{keys[e.key.toLowerCase()]=0;});

function clearAll(){[...bullets,...enemies,...sparks,...pups,...ebul].forEach(o=>scene.remove(o));if(boss)scene.remove(boss);boss=null;bullets=[];enemies=[];sparks=[];pups=[];ebul=[];}
function start(){
  clearAll();score=0;lives=3;t=0;spawnT=1;inv=0;shake=0;wl=1;bossFlag=0;$('bb').classList.add('hide');target.set(0,0);ship.position.set(0,0,0);ship.visible=true;
  state='play';$('ov').classList.add('hide');hud();
}
const ST=[
 ['Tahun 2487','Kekaisaran Zorg menyerbu Sabuk Orion dan menghancurkan koloni manusia satu demi satu. Pemimpinnya, Raja Vakrath, memimpin armada dari kapal induk raksasa.'],
 ['Pilot terakhir','Armada pelindung Bumi sudah habis. Tinggal skuadron Falcon, dan kamu satu-satunya pilot yang masih terbang. Misimu: tembus barisan musuh dan hancurkan sang raja.'],
 ['Misi dimulai','Gerakkan mouse atau sentuh layar untuk terbang, atau pakai panah dan WASD. Tembakan keluar otomatis.','Ambil kapsul emas yang jatuh dari musuh untuk memperkuat senjata. Kalau terkena tembakan, senjatamu turun satu tingkat.']];
let si=0;
function story(){const s=ST[si];$('ttl').textContent=s[0];$('msg').textContent=s[1];$('sub').textContent=s[2]||'';$('go').textContent=si<ST.length-1?'Lanjut':'Mulai misi';$('sk').classList.toggle('hide',si>=ST.length-1);}
story();
$('go').addEventListener('click',()=>{if(state==='menu'&&si<ST.length-1){si++;story();}else start();});
$('sk').addEventListener('click',()=>{si=ST.length-1;story();});
addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&(state==='menu'||state==='over')&&document.activeElement!==$('go')&&document.activeElement!==$('sk')){$('go').click();}});

function over(w){
  state='over';
  if(score>best){best=score;try{localStorage.setItem('tpl-best',best)}catch(e){}}
  $('ttl').textContent=w?'Raja Vakrath hancur':'Pesawat hancur';
  $('msg').innerHTML=(w?'Armada Zorg kocar-kacir dan Bumi selamat. Kamu pahlawan skuadron Falcon.<br>':'')+'Skor kamu <b>'+score+'</b>. Skor terbaik <b>'+best+'</b>.';
  $('sub').textContent='';$('sk').classList.add('hide');
  $('go').textContent='Main lagi';
  $('ov').classList.remove('hide');hud();
}

function shoot(){
  const P=[[-.7,0],[.7,0]];
  if(wl>=2)P.push([0,0]);
  if(wl>=3)P.push([-1.1,-10],[1.1,10]);
  if(wl>=4)P.push([-1.5,-20],[1.5,20]);
  P.forEach(p=>{
    const b=new T.Mesh(bulG,wl>=5?bulM5:bulM);b.position.set(ship.position.x+p[0],ship.position.y,-1.4);
    b.rotation.y=Math.atan2(p[1],-110);if(wl>=5)b.scale.set(2,2,1);b.userData={vx:p[1],dmg:wl>=5?2:1};
    scene.add(b);bullets.push(b);
  });
}

function spawn(){
  const e=makeEnemy(Math.random()>=.7);
  e.position.set((Math.random()*2-1)*BX,(Math.random()*2-1)*BY,-150);
  e.userData.base=e.position.x;e.userData.ph=Math.random()*6;
  e.userData.spd=(e.userData.type==='h'?.7:1)*(26+Math.min(t*.6,30))+Math.random()*8;
  scene.add(e);enemies.push(e);
}

function hitPlayer(){
  if(inv>0)return;
  lives--;wl=Math.max(1,wl-1);inv=1.6;shake=.6;burst(ship.position,'c',18);hud();
  if(lives<=0){burst(ship.position,'o',30);ship.visible=false;over();}
}

function toast(s,ms){const w=$('warn');w.textContent=s;w.classList.remove('hide');clearTimeout(toast.h);toast.h=setTimeout(()=>w.classList.add('hide'),ms||2200);}
function drop(p){
  const g=new T.Group();g.add(new T.Mesh(new T.OctahedronGeometry(.6),pupM));g.add(new T.Mesh(new T.TorusGeometry(.95,.07,8,24),pupM));g.add(glow(0xffc84a,3.4));
  g.position.set(Math.max(-BX,Math.min(BX,p.x)),Math.max(-BY,Math.min(BY,p.y)),p.z);scene.add(g);pups.push(g);
}
function spawnBoss(){
  boss=makeEnemy(true);boss.scale.setScalar(2.2);
  for(let i=-2;i<=2;i++){const c=new T.Mesh(new T.ConeGeometry(.14,.9,6),goldM);c.position.set(i*.28,.85-Math.abs(i)*.08,-.3);c.rotation.z=-i*.12;boss.add(c);}
  boss.position.set(0,1,-150);boss.userData={hp:220,max:220,fire:2.2};
  scene.add(boss);$('bf').style.width='100%';$('bb').classList.remove('hide');toast('PERINGATAN! Raja Vakrath mendekat',3000);
}
function bossFire(){
  const n=boss.userData.hp<boss.userData.max/2?5:3;
  for(let i=0;i<n;i++){
    const m=new T.Mesh(spG,ebM);m.scale.setScalar(2.4);m.position.set(boss.position.x,boss.position.y,boss.position.z+3);
    const dx=ship.position.x-m.position.x,dy=ship.position.y-m.position.y,dz=-m.position.z,l=Math.hypot(dx,dy,dz);
    m.userData={v:new T.Vector3(dx/l*32+(i-(n-1)/2)*8,dy/l*32,dz/l*32)};scene.add(m);ebul.push(m);
  }
}
function bossDown(){
  const b=boss;state='won';score+=5000;
  [...enemies,...ebul,...pups].forEach(o=>scene.remove(o));enemies=[];ebul=[];pups=[];$('bb').classList.add('hide');
  for(let i=0;i<9;i++)setTimeout(()=>burst(new T.Vector3(b.position.x+(Math.random()-.5)*14,b.position.y+(Math.random()-.5)*5,b.position.z),'o',26),i*170);
  setTimeout(()=>{scene.remove(b);boss=null;over(true);},1800);
}
function extras(dt){
  if(!boss&&!bossFlag&&score>=4000){bossFlag=1;spawnBoss();}
  for(const p of pups){
    p.position.z+=22*dt;p.rotation.y+=3*dt;p.rotation.x+=1.5*dt;
    if(!p.userData.dead&&p.position.z>-2&&p.position.z<2.5&&Math.hypot(p.position.x-ship.position.x,p.position.y-ship.position.y)<2){
      p.userData.dead=1;burst(p.position,'c',12);
      if(wl<5){wl++;toast('Senjata naik ke Lv'+wl+': '+WN[wl-1],1800);}else{score+=300;toast('Senjata sudah maksimal. +300',1500);}
      hud();
    }
  }
  pups=pups.filter(p=>{if(p.userData.dead||p.position.z>6){scene.remove(p);return false}return true;});
  if(boss){
    const B=boss.userData;
    for(const b of bullets){
      if(b.userData.dead)continue;
      if(Math.abs(b.position.z-boss.position.z)<2.5&&Math.abs(b.position.x-boss.position.x)<8&&Math.abs(b.position.y-boss.position.y)<3.5){b.userData.dead=1;B.hp-=b.userData.dmg;burst(b.position,'o',2);}
    }
    if(boss.position.z<-24)boss.position.z+=38*dt;
    else{
      boss.position.x=Math.sin(t*.7)*7;boss.position.y=1+Math.sin(t*.45)*2;boss.rotation.z=Math.cos(t*.7)*.12;
      B.fire-=dt;if(B.fire<=0){bossFire();B.fire=B.hp<B.max/2?.9:1.5;}
    }
    $('bf').style.width=Math.max(0,B.hp/B.max*100)+'%';
    if(B.hp<=0)bossDown();
  }
  for(const m of ebul){
    m.position.addScaledVector(m.userData.v,dt);
    if(!m.userData.dead&&m.position.z>-1&&m.position.z<2&&Math.hypot(m.position.x-ship.position.x,m.position.y-ship.position.y)<1.2){m.userData.dead=1;burst(m.position,'o',8);hitPlayer();}
  }
  ebul=ebul.filter(m=>{if(m.userData.dead||m.position.z>8){scene.remove(m);return false}return true;});
}
const clock=new T.Clock();
function tick(){
  requestAnimationFrame(tick);
  const dt=Math.min(clock.getDelta(),.05);
  // bintang
  const s=sg.attributes.position;
  const sv=(state==='play'?60:25)*dt;
  for(let i=0;i<N;i++){let z=s.array[i*3+2]+sv;if(z>20)z-=220;s.array[i*3+2]=z;}
  s.needsUpdate=true;

  if(state==='play'){
    t+=dt;
    const kx=(keys.arrowright||keys.d?1:0)-(keys.arrowleft||keys.a?1:0);
    const ky=(keys.arrowup||keys.w?1:0)-(keys.arrowdown||keys.s?1:0);
    if(kx||ky){target.x+=kx*20*dt;target.y+=ky*14*dt;}
    target.x=Math.max(-BX,Math.min(BX,target.x));target.y=Math.max(-BY,Math.min(BY,target.y));
    const px=ship.position.x;
    ship.position.x+=(target.x-ship.position.x)*Math.min(1,dt*10);
    ship.position.y+=(target.y-ship.position.y)*Math.min(1,dt*10);
    ship.rotation.z=-(ship.position.x-px)*5*(dt?1:0)*Math.min(1,dt*60)*.5;
    ship.rotation.z=Math.max(-.7,Math.min(.7,ship.rotation.z));
    flames.forEach(f=>{f.scale.y=.8+Math.random()*.6;});navs.forEach(n=>{n.visible=((performance.now()/450)|0)%2===0;});
    inv=Math.max(0,inv-dt);ship.visible=inv<=0||Math.floor(inv*12)%2===0;

    fireT-=dt;if(fireT<=0){shoot();fireT=wl>=4?.13:.17;}
    spawnT-=dt;if(spawnT<=0){spawn();spawnT=boss?2.2:Math.max(.35,1.0-t*.012);}
    extras(dt);

    for(const b of bullets){b.position.z-=110*dt;b.position.x+=b.userData.vx*dt;}
    for(const e of enemies){
      e.position.z+=e.userData.spd*dt;
      const fw=e.userData.type==='d'?1.6:.8,am=e.userData.type==='d'?3:2;
      e.position.x=e.userData.base+Math.sin(t*fw+e.userData.ph)*am;e.rotation.z=Math.sin(t*fw+e.userData.ph)*.5;
    }
    // tabrakan
    for(const e of enemies){
      if(e.userData.dead)continue;
      for(const b of bullets){
        if(b.userData.dead)continue;
        if(Math.abs(b.position.z-e.position.z)<1.8&&Math.hypot(b.position.x-e.position.x,b.position.y-e.position.y)<e.userData.r){
          b.userData.dead=1;e.userData.hp-=b.userData.dmg;burst(b.position,'o',3);
          if(e.userData.hp<=0){e.userData.dead=1;score+=e.userData.pts;burst(e.position,'o',16);if(Math.random()<(e.userData.type==='h'?.45:.1))drop(e.position);hud();}
          break;
        }
      }
      if(!e.userData.dead&&e.position.z>-1.5&&e.position.z<2&&Math.hypot(e.position.x-ship.position.x,e.position.y-ship.position.y)<e.userData.r+.7){
        e.userData.dead=1;burst(e.position,'o',16);hitPlayer();
      }
    }
    bullets=bullets.filter(b=>{if(b.userData.dead||b.position.z<-160){scene.remove(b);return false}return true;});
    enemies=enemies.filter(e=>{if(e.userData.dead||e.position.z>8){scene.remove(e);return false}return true;});
  }

  for(const p of sparks){p.position.addScaledVector(p.userData.v,dt);p.userData.life-=dt;p.material.opacity=Math.max(0,p.userData.life/.7);}
  sparks=sparks.filter(p=>{if(p.userData.life<=0){scene.remove(p);p.material.dispose();return false}return true;});

  shake=Math.max(0,shake-dt);
  cam.position.x=ship.position.x*.35+(shake?(Math.random()-.5)*shake:0);
  cam.position.y=1.5+ship.position.y*.35+(shake?(Math.random()-.5)*shake:0);
  cam.lookAt(ship.position.x*.15,ship.position.y*.15,-20);
  renderer.render(scene,cam);
}
hud();tick();
})();
</script>
